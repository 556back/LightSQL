  "components": {
    "schemas": {
      "AnalysisFact": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "value": {
            "type": "string",
            "title": "Value"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "label",
          "value"
        ],
        "title": "AnalysisFact"
      },
      "AnalysisFinding": {
        "properties": {
          "fact_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 8,
            "minItems": 1,
            "title": "Fact Ids"
          },
          "interpretation": {
            "type": "string",
            "maxLength": 600,
            "title": "Interpretation"
          },
          "next_step": {
            "type": "string",
            "maxLength": 400,
            "title": "Next Step",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "fact_ids",
          "interpretation"
        ],
        "title": "AnalysisFinding"
      },
      "AnalysisPublic": {
        "properties": {
          "facts": {
            "items": {
              "$ref": "#/components/schemas/AnalysisFact"
            },
            "type": "array",
            "title": "Facts"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/AnalysisFinding"
            },
            "type": "array",
            "title": "Findings",
            "default": []
          },
          "scope": {
            "type": "string",
            "title": "Scope"
          },
          "model": {
            "type": "string",
            "title": "Model",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "facts",
          "scope"
        ],
        "title": "AnalysisPublic"
      },
      "AnswerInput": {
        "properties": {
          "topic_id": {
            "type": "string",
            "format": "uuid",
            "title": "Topic Id"
          },
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          },
          "mode": {
            "type": "string",
            "enum": [
              "metrics",
              "auto",
              "explore"
            ],
            "title": "Mode",
            "default": "metrics"
          },
          "include_analysis": {
            "type": "boolean",
            "title": "Include Analysis",
            "default": false
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Revision",
            "default": 0
          },
          "entity_choices": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "maxProperties": 20,
            "title": "Entity Choices"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "topic_id",
          "question"
        ],
        "title": "AnswerInput"
      },
      "Grouping": {
        "properties": {
          "dimension_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$",
            "title": "Dimension Id"
          },
          "grain": {
            "type": "string",
            "enum": [
              "value",
              "day",
              "month",
              "year"
            ],
            "title": "Grain",
            "default": "value"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dimension_id"
        ],
        "title": "Grouping"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IntegrationResult": {
        "properties": {
          "columns": {
            "items": {
              "$ref": "#/components/schemas/ResultColumn"
            },
            "type": "array",
            "title": "Columns"
          },
          "rows": {
            "items": {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            "type": "array",
            "title": "Rows"
          },
          "truncated": {
            "type": "boolean",
            "title": "Truncated"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Notes"
          },
          "task_id": {
            "type": "string",
            "format": "uuid",
            "title": "Task Id"
          },
          "row_count": {
            "type": "integer",
            "title": "Row Count"
          },
          "queried_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Queried At"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "semantic_version": {
            "type": "integer",
            "title": "Semantic Version"
          },
          "chart": {
            "type": "string",
            "title": "Chart"
          },
          "analysis": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnalysisPublic"
              },
              {
                "type": "null"
              }
            ]
          },
          "analysis_status": {
            "type": "string",
            "title": "Analysis Status"
          },
          "evidence": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "columns",
          "rows",
          "truncated",
          "notes",
          "task_id",
          "row_count",
          "queried_at",
          "expires_at",
          "semantic_version",
          "chart",
          "analysis",
          "analysis_status",
          "evidence",
          "warnings"
        ],
        "title": "IntegrationResult"
      },
      "Ordering": {
        "properties": {
          "field": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$",
            "title": "Field"
          },
          "direction": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ],
            "title": "Direction",
            "default": "asc"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "field"
        ],
        "title": "Ordering"
      },
      "QueryFilter": {
        "properties": {
          "dimension_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$",
            "title": "Dimension Id"
          },
          "operator": {
            "type": "string",
            "enum": [
              "eq",
              "in",
              "gt",
              "gte",
              "lt",
              "lte",
              "between",
              "is_null",
              "is_not_null"
            ],
            "title": "Operator"
          },
          "values": {
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "type": "array",
            "maxItems": 50,
            "title": "Values"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dimension_id",
          "operator"
        ],
        "title": "QueryFilter"
      },
      "QueryInput": {
        "properties": {
          "topic_id": {
            "type": "string",
            "format": "uuid",
            "title": "Topic Id"
          },
          "plan": {
            "$ref": "#/components/schemas/QueryPlan"
